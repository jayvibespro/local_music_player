<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon -> "Voice command". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="voice"
        android:shortcutLongLabel="@string/shortcut_voice_long"
        android:shortcutShortLabel="@string/shortcut_voice_short">
        <intent
            android:action="com.jacksons.local_music_player.VOICE"
            android:targetClass="com.jacksons.local_music_player.MainActivity"
            android:targetPackage="com.jacksons.local_music_player" />
    </shortcut>
</shortcuts>
